+"""审查反例：测试约束的经济含义，不用历史盈利证明工程正确。"""
+from dataclasses import replace
+from pathlib import Path
+import sys
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+import numpy as np
+import pandas as pd
+import pytest
